#!/bin/sh
# chezmoi modify script: merges this policy into ~/.claude/settings.json and keeps everything else
# that Claude Code, plugins and herdr write there. Arrays are unioned in order, so local
# additions survive and re-applying is a no-op.
#
# Goal: agents can run in auto mode without being able to read credentials or send data to
# arbitrary hosts. See the "Security" section of the README for the reasoning.
input="$(cat)"
[ -n "$input" ] || input='{}'

policy='{
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,

    "excludedCommands": [
      "gh *", "gcloud *", "terraform *",
      "git fetch *", "git pull *", "git push *",
      "container *", "container-compose *"
    ],

    "filesystem": {
      "denyRead": [
        "~/.ssh", "~/.gnupg", "~/.config/gcloud", "~/.kube", "~/.config/gh", "~/.docker",
        "~/.aws", "~/.azure", "~/.terraform.d", "~/.npmrc", "~/.pypirc", "~/.netrc",
        "~/.git-credentials", "~/.codex/auth.json", "~/.pi/agent/auth.json",
        "~/.zsh_history", "~/.local/share/atuin",
        "~/Library/Keychains", "~/Library/Application Support/Bitwarden"
      ]
    },

    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": ["com.apple.coresimulator.*"],
      "allowedDomains": [
        "github.com", "*.github.com", "*.githubusercontent.com",
        "registry.npmjs.org", "*.npmjs.org", "registry.yarnpkg.com",
        "pypi.org", "files.pythonhosted.org",
        "pub.dev",
        "proxy.golang.org", "sum.golang.org",
        "crates.io", "index.crates.io", "static.crates.io",
        "repo.maven.apache.org", "repo1.maven.org", "plugins.gradle.org", "services.gradle.org",
        "dl.google.com", "maven.google.com",
        "cdn.cocoapods.org",
        "registry.terraform.io", "releases.hashicorp.com"
      ]
    }
  },

  "permissions": {
    "deny": [
      "Read(~/.ssh/**)", "Read(~/.gnupg/**)", "Read(~/.config/gcloud/**)", "Read(~/.kube/**)",
      "Read(~/.config/gh/**)", "Read(~/.docker/**)", "Read(~/.aws/**)", "Read(~/.terraform.d/**)",
      "Read(~/.npmrc)", "Read(~/.pypirc)", "Read(~/.netrc)", "Read(~/.git-credentials)",
      "Read(~/.codex/auth.json)", "Read(~/.pi/agent/auth.json)",
      "Read(~/.zsh_history)", "Read(~/.local/share/atuin/**)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)", "Read(**/.env.production)",
      "Read(**/*service-account*.json)", "Read(**/*credentials*.json)"
    ],
    "ask": [
      "Bash(terraform apply*)", "Bash(terraform destroy*)", "Bash(terraform import*)",
      "Bash(kubectl apply*)", "Bash(kubectl delete*)", "Bash(kubectl patch*)", "Bash(kubectl edit*)",
      "Bash(kubectl scale*)", "Bash(kubectl rollout*)", "Bash(helm install*)", "Bash(helm upgrade*)",
      "Bash(helm uninstall*)", "Bash(gcloud * delete*)", "Bash(gcloud * create*)",
      "Bash(git push --force*)", "Bash(git push -f*)"
    ]
  }
}'

printf '%s' "$input" | /opt/homebrew/bin/jq --argjson policy "$policy" '
  def merge($b):
    if (type == "object") and ($b | type == "object") then
      reduce ($b | keys_unsorted[]) as $k (.; .[$k] = (.[$k] | merge($b[$k])))
    elif (type == "array") and ($b | type == "array") then
      reduce $b[] as $x (.; if index([$x]) then . else . + [$x] end)
    else $b end;
  merge($policy)'
