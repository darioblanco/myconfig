# ── History ───────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history hist_ignore_all_dups hist_ignore_space share_history
setopt auto_cd interactive_comments no_beep extended_glob

# ── Plugins (zinit, installed by Homebrew) ───────────────────────────────────
source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/zinit/zinit.zsh"

# Selected oh-my-zsh pieces, without the framework.
zinit snippet OMZL::git.zsh
zinit snippet OMZP::git
zinit snippet OMZP::sudo            # Esc Esc prefixes the last command with sudo
zinit snippet OMZP::kubectl

zinit light zsh-users/zsh-completions

# ── Completion (compinit before fzf-tab, which must precede widget-wrapping plugins) ──
fpath=("${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# Rebuild the completion dump at most once a day.
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zinit cdreplay -q

zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting   # keep last

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'

# ── Tools ─────────────────────────────────────────────────────────────────────
eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(atuin init zsh --disable-up-arrow)"
source <(fzf --zsh)

# ── Aliases ───────────────────────────────────────────────────────────────────
alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'
alias la='eza -la --git --group-directories-first'
alias lt='eza --tree --level=2'
alias cat='bat --paging=never'
alias vim='nvim'
alias lg='lazygit'
alias k='kubecolor'
alias kx='kubectx'
alias kn='kubens'
alias tf='terraform'
compdef kubecolor=kubectl

# `y` opens yazi and cds into the last directory on exit.
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(<"$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then cd -- "$cwd"; fi
  rm -f -- "$tmp"
}

# `cw <name>` starts Claude Code in its own git worktree.
cw() { claude --worktree "$@"; }

# `agents` lists the running herdr agents (blocked first) and attaches to the one you pick.
# Detaching shows the list again; Esc leaves you in the shell.
agents() {
  local pane
  while pane=$({ herdr workspace list; herdr agent list; } | jq -rs '
      (.[0].result.workspaces | map({(.workspace_id): .label}) | add) as $ws
      | .[1].result.agents
      | sort_by({blocked: 0, working: 1, done: 2, idle: 3}[.agent_status] // 4)[]
      | [.pane_id,
         ({blocked: "\u001b[31m●", working: "\u001b[33m●", done: "\u001b[32m✓",
           idle: "\u001b[90m○"}[.agent_status] // "\u001b[90m?") + "\u001b[0m "
           + ({claude: "C", codex: "X", pi: "P"}[.agent] // (.agent[0:1] | ascii_upcase)),
         ($ws[.workspace_id] // "?"), .terminal_title_stripped]
      | @tsv' | column -t -s $'\t' |
    fzf --ansi --exit-0 --with-nth=2.. --prompt='agent> ' | awk '{print $1}') && [[ -n $pane ]]; do
    herdr agent attach "$pane"
  done
}

# ── Key bindings ──────────────────────────────────────────────────────────────
bindkey -e
bindkey '^U' backward-kill-line
bindkey '^X^_' redo

# Agents run on subscriptions; an exported API key would switch them to pay-per-token billing.
for _key in ANTHROPIC_API_KEY OPENAI_API_KEY; do
  [[ -n "${(P)_key}" ]] && print -P "%F{yellow}warning:%f $_key is set; Claude Code/Codex may bill the API instead of your subscription"
done
unset _key

# Remote logins open the agent picker (Mosh too: its shell inherits SSH_CONNECTION from the SSH
# login that starts it); local terminals and herdr's own panes don't.
[[ -n $SSH_CONNECTION && -z $HERDR_PANE_ID ]] && agents

# Machine-specific settings and secrets. Not tracked.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
