export LANG=en_US.UTF-8
export EDITOR=nvim
export VISUAL=nvim

export ANDROID_HOME="$HOME/Library/Android/sdk"

# Node's fetch (Corepack's downloads) honors HTTP(S)_PROXY, which the agent sandboxes set.
export NODE_USE_ENV_PROXY=1

# Testcontainers (Quarkus Dev Services and others) can't find Colima's Docker socket on its own.
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

# A phone attached through Mosh keeps its pane at phone width until its mosh-server exits, and a
# closed Termius never tells it. Exit after 30 minutes without the phone, and let `pkill -USR1`
# (`unphone` in ~/.zshrc) end only sessions that have been silent for a minute.
export MOSH_SERVER_NETWORK_TMOUT=1800
export MOSH_SERVER_SIGNAL_TMOUT=60

# Homebrew is on PATH here too, so non-interactive SSH commands (mosh-server) find it.
typeset -U path
path=(
  "$HOME/.local/bin"
  # mise shims pick each repo's versions at run time. Interactive shells put the real tool paths
  # ahead with `mise activate` (~/.zshrc); agents' non-interactive shells rely on these.
  "$HOME/.local/share/mise/shims"
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /opt/homebrew/opt/libpq/bin   # keg-only, so Homebrew doesn't link psql
  /opt/homebrew/opt/rustup/bin
  "$HOME/.cargo/bin"
  "$HOME/fvm/default/bin"
  "$HOME/.pub-cache/bin"
  "$ANDROID_HOME/platform-tools"
  "$ANDROID_HOME/emulator"
  "$ANDROID_HOME/cmdline-tools/latest/bin"
  $path
)
