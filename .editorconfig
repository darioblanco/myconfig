root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.sh,Makefile}]
indent_style = tab
indent_size = 4

[{home/dot_config/git/**,home/dot_local/bin/**,home/dot_claude/modify_*,home/dot_codex/modify_*}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
